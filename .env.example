# GridPilot environment — copy to .env and fill in your own values.
# .env is gitignored and NEVER committed. Keep it at mode 600.
#
#   cp .env.example .env
#   chmod 600 .env

# Binance Futures TESTNET API credentials (free at https://testnet.binancefuture.com)
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Telegram bot (optional — notifications and /pnl /week /status commands)
# Create a bot via @BotFather on Telegram to get the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
